#!/bin/sh
# /etc/init.d/atak-autostart - A.T.A.K. standalone start (sysvinit, runs last at boot).
# Mounts the SD card's boot partition on /mnt/sd and starts /mnt/sd/atak_boot.sh in the background. All the real work
# is in that script on the SD card, so it can be changed without rebuilding PetaLinux.
case "$1" in
    start)
        mkdir -p /mnt/sd
        i=0
        while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
        grep -q " /mnt/sd " /proc/mounts || mount -t vfat /dev/mmcblk0p1 /mnt/sd || { echo "atak: SD card not mounted"; exit 0; }
        if [ -f /mnt/sd/atak_boot.sh ]; then
            echo "atak: starting /mnt/sd/atak_boot.sh (log /var/log/atak_boot.log)"
            sh /mnt/sd/atak_boot.sh > /var/log/atak_boot.log 2>&1 &
        else
            echo "atak: no /mnt/sd/atak_boot.sh, nothing started"
        fi
        ;;
    stop)
        [ -f /var/run/atak_boot.pid ] && kill $(cat /var/run/atak_boot.pid) 2>/dev/null
        rm -f /var/run/atak_boot.pid
        killall atak_gui 2>/dev/null
        echo "atak: stopped"
        ;;
    restart)
        $0 stop; sleep 1; $0 start
        ;;
    *)
        echo "usage: $0 start | stop | restart"
        ;;
esac
exit 0
